#include <windows.h>
#include "resource.h"

IDI_VRAM_APP    ICON    "../assets/vram.ico"
IDR_XAML_LAYOUT RCDATA  "ui/AppLayout.xaml"
IDR_SVG_LOGO    RCDATA  "../assets/icons/logo.svg"
IDR_PNG_LOGO    RCDATA  "../assets/logo_ui.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Vortex Open Source Project"
            VALUE "FileDescription",  "VRam V1.0 - Memory Cleaner"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "VRam.exe"
            VALUE "LegalCopyright",   "Vortex Open Source Project"
            VALUE "OriginalFilename", "VRam.exe"
            VALUE "ProductName",      "VRam Free V1.0"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
